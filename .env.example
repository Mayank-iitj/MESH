# MESH Environment Variables for Production
# Copy these keys into your Vercel Project Settings -> Environment Variables

# 1. Database Configuration
# The connection URL to your PostgreSQL database (e.g. Vercel Postgres, Supabase, Neon)
# If using a connection pooler, make sure to append ?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true"

# 2. NextAuth Configuration
# Run `openssl rand -base64 32` to generate a secret
NEXTAUTH_SECRET="your-super-secret-nextauth-key-32-chars-minimum"
# Used for absolute URL resolution for OAuth callbacks
# In Vercel, this is automatically handled, but you can override it if you use a custom domain
NEXT_PUBLIC_API_URL="https://meshcontrolplane.vercel.app"

# 3. Google OAuth 
# Get these from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# 4. Stripe (Sandbox/Production)
# Get from Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# 5. MESH Orchestration Keys
# Used internally if external agents connect
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
